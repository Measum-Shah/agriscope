{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Request Rate (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(agriscope_http_requests_total[1m])) by (method, status)",
          "legendFormat": "{{method}} {{status}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "API Latency p50 / p95 / p99 (s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(agriscope_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(agriscope_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(agriscope_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "API Error Rate (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 * sum(rate(agriscope_http_requests_total{status=~\"5..\"}[5m])) / (sum(rate(agriscope_http_requests_total[5m])) > 0 or vector(1))",
          "legendFormat": "5xx Error Rate %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "ML Inference Latency p95 (s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(agriscope_ml_inference_duration_seconds_bucket[5m]) by (le))",
          "legendFormat": "ML p95"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "id": 5,
      "title": "API Status",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "up{job=\"agriscope-api\"}",
          "legendFormat": "API Up"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "id": 6,
      "title": "ML Service Status",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "up{job=\"agriscope-ml\"}",
          "legendFormat": "ML Up"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "id": 7,
      "title": "Predictions Rate (req/min)",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(agriscope_http_requests_total{endpoint=~\"/api/v1/predict.*\"}[5m])) * 60",
          "legendFormat": "Predictions/min"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "id": 8,
      "title": "Total Daily Predictions",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(agriscope_http_requests_total{endpoint=~\"/api/v1/predict.*\"}[24h]))",
          "legendFormat": "Today"
        }
      ]
    }
  ],
  "refresh": "10s",
