# AgriScope Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.

# ==============================================================================
# 1. APPLICATION & GENERAL ENVIRONMENT
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
APP_NAME=AgriScope
API_V1_PREFIX=/api/v1
SECRET_KEY=generate_a_super_secret_key_at_least_32_characters_long
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost
REQUEST_TIMEOUT_SECONDS=60

# ==============================================================================
# 2. DATABASE CONFIGURATION (PostgreSQL + PostGIS)
# ==============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agriscope
POSTGRES_USER=agriscope_user
POSTGRES_PASSWORD=agriscope_dev_password
DATABASE_URL=postgresql+asyncpg://agriscope_user:agriscope_dev_password@postgres:5432/agriscope
# Sync database URL for Alembic migrations:
DATABASE_SYNC_URL=postgresql://agriscope_user:agriscope_dev_password@postgres:5432/agriscope

# ==============================================================================
# 3. REDIS & CELERY CONFIGURATION
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==============================================================================
# 4. STORAGE CONFIGURATION (MinIO / S3-compatible)
# ==============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_DEFAULT_BUCKET=agriscope-bucket
STORAGE_PROVIDER=mock  # choices: minio, mock

# ==============================================================================
# 5. AUTHENTICATION & SECURITY
# ==============================================================================
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false  # set to true in production
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ==============================================================================
# 6. ML INFERENCE SERVICE
# ==============================================================================
ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_PORT=8001
DEFAULT_MODEL_VERSION=v1.0.0

# ==============================================================================
# 7. EXTERNAL PROVIDERS (WEATHER, SATELLITE, BILLING, EMAIL)
# ==============================================================================
# Weather Provider: 'nasa_power', 'open_meteo', or 'mock' (default mock for offline)
WEATHER_PROVIDER=mock
NASA_POWER_API_BASE=https://power.larc.nasa.gov/api/temporal/daily/point
OPEN_METEO_API_BASE=https://api.open-meteo.com/v1/forecast

# Satellite Provider: 'stac_sentinel', 'gee', or 'mock'
SATELLITE_PROVIDER=mock
STAC_API_URL=https://earth-search.aws.element84.com/v1
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=

# Billing Provider: 'stripe' or 'mock'
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Email Provider: 'smtp' or 'mock'
EMAIL_PROVIDER=mock
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@agriscope.local
SMTP_TLS=false

# ==============================================================================
# 8. OBSERVABILITY & MONITORING
# ==============================================================================
PROMETHEUS_METRICS_ENABLED=true
SENTRY_DSN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOG_LEVEL=INFO
